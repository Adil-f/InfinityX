# Meta App Dashboard → Instagram → API setup with Instagram login → Business login settings
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=

# Must exactly match an OAuth redirect URI registered in the App Dashboard
META_OAUTH_REDIRECT_URI=http://localhost:8000/api/oauth/instagram/callback

# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

DATABASE_URL=sqlite:///./data/infinityx.db
APP_BASE_URL=http://localhost:8000
FRONTEND_SUCCESS_URL=http://localhost:5173/

# Phase 1 default scopes (override if needed). Publish/message scopes deferred until confirmation UX.
OAUTH_SCOPES=instagram_business_basic,instagram_business_manage_insights,instagram_business_manage_comments
